<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <!--
        The Web project should only reference presentation-layer packages.
        EF Core and Identity packages are infrastructure concerns.
      -->
      <PackageReference Include="EPPlus" Version="7.1.2" />
      <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.2" />
      <PackageReference Include="QuestPDF" Version="2023.12.6" />

      <!--
        This package is required ONLY for the 'dotnet ef' command-line tools to work
        when this project is used as the startup project. It's a design-time dependency.
      -->
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
    </ItemGroup>

    <ItemGroup>
      <!-- Project references to lower layers -->
      <ProjectReference Include="..\Firmeza.Application\Firmeza.Application.csproj" />
      <ProjectReference Include="..\Firmeza.Identity\Firmeza.Identity.csproj" />
      <ProjectReference Include="..\Firmeza.Infrastructure\Firmeza.Infrastructure.csproj" />
    </ItemGroup>

</Project>
