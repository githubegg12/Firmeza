@model IEnumerable<Firmeza.Domain.Entities.Sale>

@{
    ViewData["Title"] = "Sales";
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>

    <a href="/Sales/Create" class="btn btn-primary mb-3">Nueva Venta</a>

    @if (Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sale in Model)
                {
                    <tr>
                        <td>@sale.Id</td>
                        <td>@sale.Client?.Name</td>
                        <td>@sale.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>$@sale.TotalAmount.ToString("F2")</td>
                        <td>
                            <a href="/Sales/Details/@sale.Id" class="btn btn-info btn-sm">Ver</a>
                            <a href="/Sales/Delete/@sale.Id" class="btn btn-danger btn-sm">Eliminar</a>
                            <a href="/Sales/ExportToPdf/@sale.Id" class="btn btn-warning btn-sm">PDF</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hay ventas registradas.</p>
    }
</div>
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <p>Bienvenido al panel de administrador.</p>
    
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Clientes</h5>
                    <a href="/Client/Index" class="btn btn-primary">Ver Clientes</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Productos</h5>
                    <a href="/Products/Index" class="btn btn-primary">Ver Productos</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Ventas</h5>
                    <a href="/Sales/Index" class="btn btn-primary">Ver Ventas</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Importar</h5>
                    <a href="/BulkImport/Index" class="btn btn-primary">Importar Masivo</a>
                </div>
            </div>
        </div>
    </div>
</div>

