@model IEnumerable<Firmeza.Domain.Entities.Sale>

@{
    ViewData["Title"] = "Sales";
}

<h1>Sales</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Client</th>
            <th>Date</th>
            <th>Total Amount</th>
            <th>Receipt</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Client.Name</td>
                <td>@item.SaleDate.ToShortDateString()</td>
                <td>@item.TotalAmount.ToString("C")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ReceiptUrl))
                    {
                        <a href="@item.ReceiptUrl" target="_blank">Download Receipt</a>
                    }
                    else
                    {
                        <span>No receipt</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Simple form to test sale creation -->
<hr />
<h4>Create Test Sale</h4>
<form asp-action="CreateSale" method="post">
    <div class="form-group">
        <label>Client ID:</label>
        <input type="number" name="clientId" value="1" class="form-control" />
    </div>
    <div class="form-group">
        <label>Product ID:</label>
        <input type="number" name="productId" value="1" class="form-control" />
    </div>
    <div class="form-group">
        <label>Quantity:</label>
        <input type="number" name="quantity" value="5" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Create Sale</button>
</form>
