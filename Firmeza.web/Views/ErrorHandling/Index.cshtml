@{
    ViewData["Title"] = "Error Handling";
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <p>Prueba de manejo de errores.</p>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">
            @ViewBag.Message
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <form method="post" action="/ErrorHandling/ProcessAge" class="mt-4">
        <div class="form-group">
            <label for="ageInput">Ingresa tu edad:</label>
            <input type="text" class="form-control" id="ageInput" name="ageInput" placeholder="Ej: 25" />
        </div>
        <button type="submit" class="btn btn-primary">Enviar</button>
    </form>
</div>

