@model Firmeza.web.ViewModels.LoginViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1>Iniciar Sesión</h1>

            <form method="post" asp-action="Login">
                
                @await Html.PartialAsync("_UserFieldsPartial", new Firmeza.web.ViewModels.UserFieldsViewModel
                {
                    IncludeEmail = false,
                    IncludeConfirmPassword = false
                })

                <input type="hidden" asp-for="ReturnUrl" />

                <button type="submit" class="btn btn-primary mt-3 w-100">Entrar</button>

                <p class="mt-3">
                    ¿Aún no tienes cuenta?
                    <a asp-action="Register">Regístrate aquí</a>
                </p>

            </form>
        </div>
    </div>
</div>