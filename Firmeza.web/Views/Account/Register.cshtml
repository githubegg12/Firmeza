@model Firmeza.web.ViewModels.RegisterViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1>Registro</h1>

            <form method="post" asp-action="Register">

                @await Html.PartialAsync("_UserFieldsPartial", new Firmeza.web.ViewModels.UserFieldsViewModel
                {
                    IncludeEmail = true,
                    IncludeConfirmPassword = true
                })

                <button type="submit" class="btn btn-success w-100 mt-3">Crear cuenta</button>

            </form>
        </div>
    </div>
</div>