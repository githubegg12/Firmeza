@model Firmeza.Domain.Entities.Sale

@{
    ViewData["Title"] = "Detalles de Venta";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="bi bi-receipt me-2"></i>Detalles de Venta #@Model.Id
        </h1>
        <div>
            <a asp-action="Index" class="btn btn-secondary btn-sm shadow-sm me-2">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
            <a asp-action="ExportToPdf" asp-route-id="@Model.Id" class="btn btn-danger btn-sm shadow-sm" target="_blank">
                <i class="bi bi-file-earmark-pdf me-1"></i>Exportar PDF
            </a>
        </div>
    </div>

    @* Mensajes de éxito/error *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Información de la Venta -->
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-primary text-white">
                    <h6 class="m-0 font-weight-bold">
                        <i class="bi bi-info-circle me-2"></i>Información de la Venta
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">ID de Venta</label>
                            <p class="fw-bold">#@Model.Id</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Fecha de Venta</label>
                            <p class="fw-bold">@Model.SaleDate.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Cliente</label>
                            <p class="fw-bold">@Model.User?.FullName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Documento</label>
                            <p class="fw-bold">@Model.User?.DocumentId</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="text-muted small">Email</label>
                            <p class="fw-bold">@Model.User?.Email</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Dirección</label>
                            <p class="fw-bold">@Model.User?.Address</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Productos Vendidos -->
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-success text-white">
                    <h6 class="m-0 font-weight-bold">
                        <i class="bi bi-cart-check me-2"></i>Productos Vendidos
                    </h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Imagen</th>
                                    <th>Producto</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.SaleDetails)
                                {
                                    var subtotal = detail.Quantity * detail.UnitPrice;
                                    <tr>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-primary" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#imageModal" 
                                                    data-image="@(string.IsNullOrEmpty(detail.Product?.ImageUrl) ? "/images/no-image.png" : detail.Product.ImageUrl)"
                                                    data-name="@detail.Product?.Name">
                                                <i class="bi bi-image"></i>
                                            </button>
                                        </td>
                                        <td>
                                            <div class="fw-bold">@detail.Product?.Name</div>
                                            <div class="small text-muted">@detail.Product?.Description</div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">@detail.Quantity</span>
                                        </td>
                                        <td class="text-end">@detail.UnitPrice.ToString("C")</td>
                                        <td class="text-end fw-bold">@subtotal.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Resumen -->
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-info text-white">
                    <h6 class="m-0 font-weight-bold">
                        <i class="bi bi-calculator me-2"></i>Resumen
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Subtotal:</span>
                        <span class="fw-bold">@Model.TotalAmount.ToString("C")</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="h5 mb-0">Total:</span>
                        <span class="h5 mb-0 text-success fw-bold">@Model.TotalAmount.ToString("C")</span>
                    </div>
                    <div class="mt-4">
                        <div class="small text-muted mb-2">Acciones Rápidas</div>
                        <div class="d-grid gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil-square me-1"></i>Editar Venta
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash me-1"></i>Eliminar Venta
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información Adicional -->
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="bi bi-info-square me-2"></i>Información Adicional
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small">Total de Productos</label>
                        <p class="fw-bold">@Model.SaleDetails.Sum(d => d.Quantity) unidades</p>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small">Productos Diferentes</label>
                        <p class="fw-bold">@Model.SaleDetails.Count() productos</p>
                    </div>
                    <div>
                        <label class="text-muted small">Estado</label>
                        <p><span class="badge bg-success">Completada</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para ver imagen del producto -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">Imagen del Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" alt="Producto" class="img-fluid rounded" style="max-height: 500px;">
                <p id="modalProductName" class="mt-3 fw-bold"></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Manejar el modal de imagen
        var imageModal = document.getElementById('imageModal');
        imageModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var imageUrl = button.getAttribute('data-image');
            var productName = button.getAttribute('data-name');
            
            var modalImage = document.getElementById('modalImage');
            var modalProductName = document.getElementById('modalProductName');
            
            modalImage.src = imageUrl;
            modalProductName.textContent = productName;
            
            // Manejar error de carga de imagen
            modalImage.onerror = function() {
                this.src = '/images/no-image.png';
            };
        });
    </script>
}
