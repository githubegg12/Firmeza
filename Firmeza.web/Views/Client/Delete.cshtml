@model Firmeza.Domain.Entities.Client

@{
    ViewData["Title"] = "Eliminar Cliente";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-trash-fill me-2"></i>Eliminar Cliente</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>¿Está seguro que desea eliminar este cliente?</strong>
                        <p class="mb-0 mt-2">Esta acción no se puede deshacer.</p>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Información del Cliente</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-hash me-1"></i>ID
                                    </label>
                                    <p class="form-control-plaintext">#@Model.Id</p>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-person-fill me-1"></i>Nombre
                                    </label>
                                    <p class="form-control-plaintext">@Model.Name</p>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-card-text me-1"></i>Documento
                                    </label>
                                    <p class="form-control-plaintext">
                                        <span class="badge bg-secondary">@Model.Document</span>
                                    </p>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-envelope-fill me-1"></i>Email
                                    </label>
                                    <p class="form-control-plaintext">
                                        <a href="mailto:@Model.Email">@Model.Email</a>
                                    </p>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-telephone-fill me-1"></i>Teléfono
                                    </label>
                                    <p class="form-control-plaintext">@(Model.Phone ?? "No especificado")</p>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-geo-alt-fill me-1"></i>Dirección
                                    </label>
                                    <p class="form-control-plaintext">@Model.Address</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-1"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill me-1"></i>Confirmar Eliminación
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
