@model IEnumerable<Firmeza.Domain.Entities.Client>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>

    <a href="/Client/Create" class="btn btn-primary mb-3">Nuevo Cliente</a>
    <a href="/Client/ExportToExcel" class="btn btn-success mb-3">Exportar Excel</a>
    <a href="/Client/ExportToPdf" class="btn btn-warning mb-3">Exportar PDF</a>

    <form method="get" class="mb-3">
        <div class="input-group">
            <input type="text" class="form-control" name="searchString" placeholder="Buscar por nombre o documento" />
            <button class="btn btn-outline-secondary" type="submit">Buscar</button>
        </div>
    </form>

    @if (Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Documento</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in Model)
                {
                    <tr>
                        <td>@client.Id</td>
                        <td>@client.Name</td>
                        <td>@client.Document</td>
                        <td>@client.Email</td>
                        <td>@client.Phone</td>
                        <td>@client.Address</td>
                        <td>
                            <a href="/Client/Edit/@client.Id" class="btn btn-info btn-sm">Editar</a>
                            <a href="/Client/Delete/@client.Id" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hay clientes registrados.</p>
    }
</div>

