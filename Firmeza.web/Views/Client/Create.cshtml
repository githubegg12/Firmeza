@model Firmeza.web.Models.CreateClientViewModel

@{
    ViewData["Title"] = "Crear Cliente";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="bi bi-person-plus-fill me-2"></i>Crear Nuevo Cliente
            </h1>
            <p class="text-muted mt-1">Registra un nuevo cliente en el sistema.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver al Listado
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Información del Cliente</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <!-- Nombre y Apellido -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-bold">
                                    Nombre(s) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="FirstName" class="form-control" placeholder="Juan" required />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-bold">
                                    Apellido(s) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="LastName" class="form-control" placeholder="Pérez García" required />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">
                                Email <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="ejemplo@correo.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Documento y Teléfono -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DocumentId" class="form-label fw-bold">
                                    Documento de Identidad <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DocumentId" class="form-control" placeholder="12345678" required />
                                <span asp-validation-for="DocumentId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">
                                    Teléfono <span class="text-danger">*</span>
                                </label>
                                <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="3001234567" required />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Dirección -->
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold">
                                Dirección <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Address" class="form-control" placeholder="Calle 123 #45-67" required />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- Contraseña y Confirmación -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-bold">
                                    Contraseña <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Password" class="form-control" placeholder="••••••••" required />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold">
                                    Confirmar Contraseña <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" required />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Registrar Cliente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
