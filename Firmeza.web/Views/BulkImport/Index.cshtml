@{
    ViewData["Title"] = "BulkImport";
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    <p>Importa datos masivos desde un archivo Excel.</p>

    @if (Model != null)
    {
        <div class="alert alert-info">
            <h4>Resultado de la importación:</h4>
            <p>Total de filas: @Model.TotalRows</p>
            <p>Insertadas exitosamente: @Model.SuccessfulInserts</p>
            <p>Actualizadas exitosamente: @Model.SuccessfulUpdates</p>
            <p>Filas fallidas: @Model.FailedRows</p>
        </div>

        <h5>Mensajes de log:</h5>
        <ul class="list-group">
            @foreach (var message in Model.LogMessages)
            {
                <li class="list-group-item">@message</li>
            }
        </ul>
    }

    <form method="post" enctype="multipart/form-data" class="mt-4">
        <div class="form-group">
            <label for="excelFile">Selecciona archivo Excel:</label>
            <input type="file" class="form-control" id="excelFile" name="excelFile" accept=".xlsx,.xls" required />
        </div>
        <button type="submit" class="btn btn-primary">Importar</button>
    </form>
</div>

