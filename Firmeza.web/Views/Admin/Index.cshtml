@model Firmeza.web.Models.DashboardViewModel

<div class="container mt-4">
    <h1 class="mb-4">Panel administrativo</h1>

    <div class="row">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-header">Clientes</div>
                <div class="card-body">
                    <h3>@Model.TotalClients</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-header">Productos</div>
                <div class="card-body">
                    <h3>@Model.TotalProducts</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-header">Ventas</div>
                <div class="card-body">
                    <h3>@Model.TotalSales</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3">
                <div class="card-header">Ingresos</div>
                <div class="card-body">
                    <h3>$@Model.TotalRevenue</h3>
                </div>
            </div>
        </div>
    </div>

    <p class="text-muted mt-3">Última actualización: @Model.LastUpdated</p>
</div>