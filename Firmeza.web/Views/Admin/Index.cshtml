@model Firmeza.web.Models.DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard Administrativo";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-4 fw-bold text-dark">
                        <i class="bi bi-speedometer2 me-3 text-primary"></i>Dashboard Administrativo
                    </h1>
                    <p class="text-muted mb-0">Bienvenido al panel de control</p>
                </div>
                <div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Metrics Cards -->
    <div class="row g-4 mb-5">
        <!-- Clients Card -->
        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card border-0 shadow-sm h-100 metric-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="metric-icon bg-primary bg-gradient">
                                <i class="bi bi-people-fill"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="text-muted text-uppercase small fw-semibold">Clientes</div>
                            <div class="fs-2 fw-bold text-dark">@Model.TotalClients</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 p-3">
                    <a href="@Url.Action("Index", "Client")" class="text-primary text-decoration-none small">
                        Ver todos <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Products Card -->
        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card border-0 shadow-sm h-100 metric-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="metric-icon bg-success bg-gradient">
                                <i class="bi bi-box-seam-fill"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="text-muted text-uppercase small fw-semibold">Productos</div>
                            <div class="fs-2 fw-bold text-dark">@Model.TotalProducts</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 p-3">
                    <a href="@Url.Action("Index", "Product")" class="text-success text-decoration-none small">
                        Ver todos <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Sales Card -->
        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card border-0 shadow-sm h-100 metric-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="metric-icon bg-warning bg-gradient">
                                <i class="bi bi-receipt-cutoff"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="text-muted text-uppercase small fw-semibold">Ventas</div>
                            <div class="fs-2 fw-bold text-dark">@Model.TotalSales</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 p-3">
                    <a href="@Url.Action("Index", "Sale")" class="text-warning text-decoration-none small">
                        Ver todas <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Revenue Card -->
        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card border-0 shadow-sm h-100 metric-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="metric-icon bg-danger bg-gradient">
                                <i class="bi bi-currency-dollar"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="text-muted text-uppercase small fw-semibold">Ingresos Totales</div>
                            <div class="fs-2 fw-bold text-dark">$@Model.TotalRevenue.ToString("N2")</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 p-3">
                    <a href="@Url.Action("RevenueReport", "Report")" class="text-danger text-decoration-none small">
                        Ver reporte <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-lightning-charge-fill me-2 text-warning"></i>Acciones Rápidas
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <a href="@Url.Action("Create", "Client")" class="btn btn-outline-primary w-100 py-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-person-plus-fill me-2"></i> Nuevo Cliente
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a href="@Url.Action("Create", "Product")" class="btn btn-outline-success w-100 py-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-plus-circle-fill me-2"></i> Nuevo Producto
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a href="@Url.Action("Create", "Sale")" class="btn btn-outline-warning w-100 py-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-cart-plus-fill me-2"></i> Nueva Venta
                            </a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <a href="@Url.Action("Index", "BulkImport")" class="btn btn-outline-info w-100 py-3 d-flex align-items-center justify-content-center">
                                <i class="bi bi-file-earmark-arrow-down-fill me-2"></i> Importar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Last Updated Info -->
    <div class="row">
        <div class="col-12">
            <p class="text-muted small text-center">
                <i class="bi bi-clock-fill me-1"></i>
                Última actualización: @Model.LastUpdated.ToString("dd/MM/yyyy HH:mm:ss")
            </p>
        </div>
    </div>
</div>

<style>
    .metric-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .metric-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
    }
    
    .metric-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
    }
</style>